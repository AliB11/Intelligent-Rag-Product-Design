# ---------------------------------------------------------------------------
# Intelligent Banking Product Generator & ALM Digital Twin Simulator
# Copy to `.env` and adjust. Never commit real credentials.
# ---------------------------------------------------------------------------

# PostgreSQL (Drizzle ORM). The Next.js workspace reads this directly.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Redis / Celery broker for heavy Monte Carlo jobs (Python backend workspace)
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# Vector store (ChromaDB / PGVector) pre-seeded with CBI directives
CHROMA_HOST=127.0.0.1
CHROMA_PORT=8001
CHROMA_COLLECTION=iran_banking_kb
PGVECTOR_TABLE=kb_documents
EMBEDDING_DIM=128

# Optional LLM provider for the intent/critic agents (structured output only).
# The financial engine never calls an LLM; these keys only drive reasoning text.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LANGGRAPH_CHECKPOINT_TABLE=agent_checkpoints

# Market / regulatory anchors (defaults live in src/lib/domain/constants.ts)
CBI_INTERBANK_RATE=0.23
CBI_HURDLE_MARGIN=0.02
CBI_TREASURY_RATE=0.245
CBI_QH_MAX_COMMISSION=0.04
CBI_MORABAHA_MAX_RATE=0.23
ALM_HORIZON_MONTHS=60
MONTE_CARLO_RUNS=1000

# API
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
