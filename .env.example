# ---------------------------------------------------------------------------
# Intelligent Banking Product Generator & ALM Digital Twin Simulator
# Copy to `.env` and adjust. Never commit real credentials.
# Only variables read by the current runtime/deployment are listed here.
# ---------------------------------------------------------------------------

# PostgreSQL (used by Drizzle and repository persistence when running outside Compose)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Docker Compose PostgreSQL and app ports
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=app_db
POSTGRES_PORT=5432
APP_PORT=3000

# Monte Carlo run count, candidate count, critic iterations and sensitivity are
# request-level controls in the UI/API. Defaults and accepted limits live in
# src/lib/domain/constants.ts; the final ALM run always uses the requested count.

# The browser uses same-origin relative API routes; do not set an API localhost URL.
